# Docker Compose development defaults. Rails already uses these values when unset.
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5433
DATABASE_USER=pippal
DATABASE_PASSWORD=pippal

# Production uses a managed PostgreSQL URL and SMTP credentials.
DATABASE_URL=postgresql://user:password@host/database
APP_HOST=crm.example.com
SMTP_ADDRESS=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=leads@example.com

