<% content_for :title, "Pages & sources · Pippal CRM" %>
<div class="flex flex-wrap items-end justify-between gap-4"><div><p class="eyebrow">Acquisition evidence</p><h1 class="mt-2 text-3xl font-extrabold tracking-tight">What creates intent?</h1><p class="mt-2 text-sm text-slate-500">Raw attribution stays visible; missing values remain unknown.</p></div><%= render "shared/date_filters", path: insights_path, range: @range %></div>
<div class="mt-7 grid gap-5 xl:grid-cols-2">
  <section class="panel overflow-hidden"><div class="border-b border-slate-100 px-6 py-5"><p class="eyebrow">Top pages</p><h2 class="mt-1 text-lg font-bold">Pages that move people</h2></div><div class="divide-y divide-slate-100"><% @summary[:top_pages].each_with_index do |page, index| %><div class="grid grid-cols-[32px_1fr_auto] items-center gap-3 px-6 py-4"><span class="text-xs font-black text-slate-300"><%= (index + 1).to_s.rjust(2, "0") %></span><div class="min-w-0"><p class="truncate text-sm font-bold"><%= URI.parse(page[:page_url]).path.presence || "/" rescue page[:page_url] %></p><p class="mt-1 truncate text-xs text-slate-400"><%= page[:page_url] %></p></div><div class="text-right"><p class="text-sm font-extrabold"><%= page[:intent] %> intent</p><p class="text-xs text-slate-400"><%= page[:page_views] %> views</p></div></div><% end %></div></section>
  <section class="panel overflow-hidden"><div class="border-b border-slate-100 px-6 py-5"><p class="eyebrow">Top sources</p><h2 class="mt-1 text-lg font-bold">Where visitors come from</h2></div><div class="divide-y divide-slate-100"><% max_intent = [@summary[:top_sources].map { |source| source[:intent] }.max.to_i, 1].max %><% @summary[:top_sources].each do |source| %><div class="px-6 py-4"><div class="flex items-center justify-between"><p class="text-sm font-bold"><%= source[:source].humanize %></p><p class="text-xs font-semibold text-slate-400"><%= source[:visits] %> visits · <%= source[:intent] %> intent</p></div><div class="mt-3 h-1.5 overflow-hidden rounded-full bg-slate-100"><div class="h-full rounded-full bg-amber-300" style="width:<%= source[:intent].to_f / max_intent * 100 %>%"></div></div></div><% end %></div></section>
</div>

