<% content_for :title, "Locations · Pippal CRM" %>
<div class="flex flex-wrap items-end justify-between gap-4"><div><p class="eyebrow">Location performance</p><h1 class="mt-2 text-3xl font-extrabold tracking-tight">See where demand turns into outcomes.</h1></div><%= render "shared/date_filters", path: locations_path, range: @range %></div>
<section class="mt-7 grid gap-4 md:grid-cols-2 xl:grid-cols-3">
  <% @summary[:locations].each do |location| %><article class="panel p-6"><div class="flex items-center justify-between"><span class="grid h-10 w-10 place-items-center rounded-xl bg-amber-50 text-amber-700"><%= icon(:locations, class_name: "h-5 w-5") %></span><span class="text-xs font-bold text-slate-400"><%= location[:leads] %> leads</span></div><h2 class="mt-5 text-xl font-extrabold"><%= location[:name] %></h2><div class="mt-5 grid grid-cols-3 gap-2 border-t border-slate-100 pt-5"><div><p class="eyebrow">Visits</p><p class="mt-1 text-lg font-bold"><%= location[:visits] %></p></div><div><p class="eyebrow">Intent</p><p class="mt-1 text-lg font-bold"><%= location[:intent] %></p></div><div><p class="eyebrow">Won</p><p class="mt-1 text-lg font-bold"><%= location[:won] %></p></div></div><div class="mt-4 rounded-xl bg-emerald-50 px-4 py-3"><p class="text-[10px] font-bold uppercase tracking-wider text-emerald-600">Attributed value</p><p class="mt-1 text-xl font-extrabold text-emerald-800"><%= money(location[:attributed_value]) %></p></div></article><% end %>
</section>

