<div style="margin:0 auto;max-width:540px;padding:28px 28px 24px;background:#ffffff;border:1px solid #e2e8f0;border-radius:12px;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Helvetica,Arial,sans-serif;color:#0f172a;">
  <p style="margin:0 0 20px;font-size:11px;font-weight:700;letter-spacing:.14em;text-transform:uppercase;color:#94a3b8;">Pippal CRM &middot; Lead alert</p>

  <h1 style="margin:0 0 6px;font-size:20px;line-height:1.3;">New <%= @lead.lead_type.humanize.downcase %> lead</h1>
  <p style="margin:0 0 20px;font-size:14px;line-height:1.5;color:#475569;"><strong style="color:#0f172a;"><%= @contact.name.presence || "A website visitor" %></strong> just submitted a request.</p>

  <% if @lead.message.present? %>
    <div style="margin:0 0 20px;padding:12px 16px;border-left:3px solid #cbd5e1;font-size:14px;line-height:1.6;color:#334155;white-space:pre-line;"><%= @lead.message %></div>
  <% end %>

  <table role="presentation" style="border-collapse:collapse;font-size:13px;">
    <% {
      "Location" => @lead.location&.name || "Unknown",
      "Email" => @contact.email,
      "Phone" => @contact.phone,
      "Received" => l(@lead.occurred_at.in_time_zone(@lead.tenant.time_zone), format: :short)
    }.each do |label, value| %>
      <% next if value.blank? %>
      <tr>
        <td style="padding:4px 16px 4px 0;font-weight:600;color:#94a3b8;vertical-align:top;"><%= label %></td>
        <td style="padding:4px 0;color:#334155;"><%= value %></td>
      </tr>
    <% end %>
  </table>

  <p style="margin:24px 0 28px;">
    <a href="<%= lead_url(@lead) %>" style="display:inline-block;padding:10px 18px;border-radius:8px;background:#0f172a;color:#ffffff;font-size:14px;font-weight:600;text-decoration:none;">Open lead in Pippal CRM</a>
  </p>

  <p style="margin:0;padding-top:14px;border-top:1px solid #e2e8f0;font-size:12px;line-height:1.5;color:#94a3b8;">You&rsquo;re receiving this because lead alerts are enabled for <%= @lead.location&.name || "your workspace" %>.</p>
</div>
