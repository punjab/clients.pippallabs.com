<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Pippal CRM" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="#0f172a">
    <meta name="application-name" content="Pippal CRM">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>
  <body class="min-h-screen bg-[#f6f6f1] text-slate-900 antialiased">
    <% if authenticated? %>
      <div class="min-h-screen lg:grid lg:grid-cols-[232px_1fr]">
        <aside class="border-b border-slate-200 bg-white px-4 py-4 lg:fixed lg:inset-y-0 lg:w-[232px] lg:border-b-0 lg:border-r lg:px-4 lg:py-6">
          <div class="flex items-center justify-between lg:block">
            <%= link_to root_path, class: "flex items-center gap-3 px-2" do %>
              <span class="grid h-9 w-9 place-items-center rounded-xl bg-amber-300 text-lg font-black text-slate-950 shadow-sm">P</span>
              <span><span class="block text-sm font-extrabold tracking-tight">Pippal Labs</span><span class="block text-[10px] font-bold uppercase tracking-[.18em] text-slate-400">Light CRM</span></span>
            <% end %>
            <span class="rounded-full bg-slate-100 px-2.5 py-1 text-[10px] font-bold uppercase tracking-wider text-slate-500 lg:hidden"><%= current_membership.role.humanize %></span>
          </div>

          <nav class="mt-4 grid grid-cols-3 gap-1 lg:mt-9 lg:block lg:space-y-1">
            <%= nav_link "Overview", root_path, :overview %>
            <%= nav_link "Leads", leads_path, :leads %>
            <%= nav_link "Locations", locations_path, :locations %>
            <%= nav_link "Pages & sources", insights_path, :insights %>
            <%= nav_link "Reports", reports_path, :reports %>
            <% if current_tenant.feature_enabled?(:recruiting) && current_membership.can_access_recruiting? %>
              <%= nav_link "Recruiting", recruiting_path, :recruiting %>
            <% end %>
            <% if current_membership.agency_admin? %>
              <%= nav_link "Workspace", workspace_path, :settings %>
            <% end %>
          </nav>

          <div class="mt-8 hidden border-t border-slate-100 pt-5 lg:block">
            <p class="px-3 text-[10px] font-bold uppercase tracking-[.18em] text-slate-400">Signed in as</p>
            <div class="mt-3 flex items-center gap-3 px-3">
              <span class="grid h-8 w-8 place-items-center rounded-full bg-slate-900 text-[11px] font-bold text-white"><%= initials(current_user.name) %></span>
              <span class="min-w-0"><span class="block truncate text-sm font-semibold"><%= current_user.name %></span><span class="block truncate text-xs text-slate-400"><%= current_membership.role.humanize %></span></span>
            </div>
            <%= button_to "Sign out", session_path, method: :delete, class: "mt-4 px-3 text-xs font-semibold text-slate-400 hover:text-slate-900" %>
          </div>
        </aside>

        <div class="lg:col-start-2">
          <header class="flex min-h-16 items-center justify-between border-b border-slate-200/80 bg-white/80 px-5 backdrop-blur lg:px-8">
            <div>
              <p class="text-[10px] font-bold uppercase tracking-[.16em] text-slate-400">Workspace</p>
              <p class="text-sm font-bold"><%= current_tenant.name %></p>
            </div>
            <div class="flex items-center gap-3">
              <% if current_user.memberships.size > 1 %>
                <%= form_with url: switch_session_path, class: "hidden sm:block" do |form| %>
                  <%= form.select :membership_id, current_user.memberships.includes(:tenant).map { |membership| [membership.tenant.name, membership.id] }, { selected: current_membership.id }, { onchange: "this.form.requestSubmit()", class: "rounded-xl border-slate-200 bg-white text-sm font-semibold" } %>
                <% end %>
              <% end %>
              <% if current_membership.agency_admin? %>
                <%= link_to "New workspace", agency_tenants_path, class: "rounded-xl bg-slate-900 px-4 py-2 text-xs font-bold text-white transition hover:bg-slate-700" %>
              <% end %>
            </div>
          </header>

          <main class="mx-auto max-w-[1480px] px-5 py-7 lg:px-8 lg:py-9">
            <% if notice %><div class="mb-5 rounded-xl border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm font-medium text-emerald-800"><%= notice %></div><% end %>
            <% if alert %><div class="mb-5 rounded-xl border border-rose-200 bg-rose-50 px-4 py-3 text-sm font-medium text-rose-800"><%= alert %></div><% end %>
            <%= yield %>
          </main>
        </div>
      </div>
    <% else %>
      <%= yield %>
    <% end %>
  </body>
</html>
