<% content_for :title, "Agency workspaces · Pippal CRM" %>
<div class="grid gap-6 xl:grid-cols-[1fr_420px]"><section><p class="eyebrow">Pippal portfolio</p><h1 class="mt-2 text-3xl font-extrabold tracking-tight">Client workspaces</h1><div class="panel mt-6 divide-y divide-slate-100"><% @memberships.each do |membership| %><div class="flex items-center justify-between px-5 py-4"><div><p class="text-sm font-bold"><%= membership.tenant.name %></p><p class="mt-1 text-xs text-slate-400"><%= membership.tenant.slug %></p></div><%= button_to "Open", switch_session_path(membership_id: membership.id), class: "button-secondary !py-2 !text-xs" %></div><% end %></div></section><section class="panel h-fit p-6"><p class="eyebrow">New workspace</p><h2 class="mt-2 text-xl font-bold">Onboard a client</h2><%= form_with url: agency_tenants_path, class: "mt-5 space-y-3" do |form| %><%= form.text_field :name, required: true, placeholder: "Client name", class: "field" %><%= form.text_field :slug, required: true, placeholder: "client-slug", class: "field" %><%= form.text_field :time_zone, value: "America/Vancouver", class: "field" %><%= form.email_field :notification_email, placeholder: "Default lead alert email", class: "field" %><%= form.text_field :location_name, required: true, placeholder: "First location name", class: "field" %><%= form.text_field :location_key, required: true, placeholder: "first-location", class: "field" %><%= form.text_field :allowed_domain, required: true, placeholder: "client.example", class: "field" %><%= form.submit "Create workspace", class: "button-primary w-full" %><% end %></section></div>

