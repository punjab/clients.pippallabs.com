<% content_for :title, "Clients · Pippal CRM" %>
<div class="grid gap-6 xl:grid-cols-[1fr_420px]"><section><p class="eyebrow">Pippal portfolio</p><h1 class="mt-2 text-3xl font-extrabold tracking-tight">Clients</h1><% if super_admin? %><div class="panel mt-6 divide-y divide-slate-100"><% @tenants.each do |tenant| %><div class="flex items-center justify-between px-5 py-4"><div><p class="text-sm font-bold"><%= tenant.name %></p><p class="mt-1 text-xs text-slate-400"><%= tenant.slug %></p></div><%= button_to "Open", switch_session_path(tenant_id: tenant.id), class: "button-secondary !py-2 !text-xs" %></div><% end %></div><div class="panel mt-6"><div class="border-b border-slate-100 px-5 py-4"><p class="eyebrow">Agency admins</p></div><div class="divide-y divide-slate-100"><% @agency_admin_memberships.each do |membership| %><div class="flex items-center justify-between px-5 py-4"><div><p class="text-sm font-bold"><%= membership.user.name %></p><p class="mt-1 text-xs text-slate-400"><%= membership.user.email_address %></p></div><p class="text-xs font-semibold text-slate-500"><%= membership.tenant.name %></p></div><% end %><% if @agency_admin_memberships.empty? %><p class="px-5 py-4 text-sm text-slate-400">No agency admins yet.</p><% end %></div></div><% else %><div class="panel mt-6 divide-y divide-slate-100"><% @memberships.each do |membership| %><div class="flex items-center justify-between px-5 py-4"><div><p class="text-sm font-bold"><%= membership.tenant.name %></p><p class="mt-1 text-xs text-slate-400"><%= membership.tenant.slug %></p></div><%= button_to "Open", switch_session_path(membership_id: membership.id), class: "button-secondary !py-2 !text-xs" %></div><% end %></div><% end %></section><section class="panel h-fit p-6"><p class="eyebrow">New client</p><h2 class="mt-2 text-xl font-bold">Onboard a client</h2><%= form_with url: agency_tenants_path, class: "mt-5 space-y-3" do |form| %><%= form.text_field :name, required: true, placeholder: "Client name", class: "field" %><%= form.text_field :slug, required: true, placeholder: "client-slug", class: "field" %><%= form.text_field :time_zone, value: "America/Vancouver", class: "field" %><%= form.email_field :notification_email, placeholder: "Default lead alert email", class: "field" %><%= form.text_field :location_name, required: true, placeholder: "First location name", class: "field" %><%= form.text_field :location_key, required: true, placeholder: "first-location", class: "field" %><%= form.text_field :allowed_domain, required: true, placeholder: "client.example", class: "field" %><%= form.submit "Create client", class: "button-primary w-full" %><% end %></section></div>
