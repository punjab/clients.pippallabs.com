<% content_for :title, "Overview · Pippal CRM" %>
<div class="flex flex-wrap items-end justify-between gap-4">
  <div><p class="eyebrow">Account overview</p><h1 class="mt-2 text-3xl font-extrabold tracking-tight">Demand, through to outcome.</h1><p class="mt-2 text-sm text-slate-500">A clear view of the signals that need action—not a pile of vanity metrics.</p></div>
  <%= render "shared/date_filters", path: root_path, range: @range %>
</div>

<section class="mt-7 grid gap-4 sm:grid-cols-2 xl:grid-cols-4">
  <%= render "shared/metric_card", label: "Visits", value: number_with_delimiter(@summary[:totals][:visits]), caption: "Distinct accepted website sessions", tone: "bg-blue-50 text-blue-700", icon_name: :insights %>
  <%= render "shared/metric_card", label: "Order intent", value: number_with_delimiter(@summary[:totals][:order_intent]), caption: "Order clicks, reported as intent", tone: "bg-amber-50 text-amber-700", icon_name: :arrow %>
  <%= render "shared/metric_card", label: "Leads", value: number_with_delimiter(@summary[:totals][:leads]), caption: "#{@summary[:totals][:lead_conversion_rate]}% of visits converted", tone: "bg-violet-50 text-violet-700", icon_name: :leads %>
  <%= render "shared/metric_card", label: "Won value", value: money(@summary[:totals][:attributed_value]), caption: "Actual value from won leads only", tone: "bg-emerald-50 text-emerald-700", icon_name: :reports %>
</section>

<section class="mt-5 grid gap-5 xl:grid-cols-[1.55fr_1fr]">
  <article class="panel p-5 lg:p-6">
    <div class="flex items-center justify-between"><div><p class="eyebrow">Activity trend</p><h2 class="mt-1 text-lg font-bold">Visits and leads</h2></div><div class="flex gap-4 text-xs font-semibold text-slate-400"><span><i class="mr-1 inline-block h-2 w-2 rounded-full bg-slate-900"></i>Visits</span><span><i class="mr-1 inline-block h-2 w-2 rounded-full bg-amber-300"></i>Leads</span></div></div>
    <% max_value = [@summary[:trend].map { |point| point[:visits] }.max.to_i, 1].max %>
    <div class="mt-8 flex h-44 items-end gap-1.5 border-b border-slate-100">
      <% @summary[:trend].each do |point| %>
        <div class="group relative flex h-full min-w-0 flex-1 items-end gap-px" title="<%= point[:date] %>: <%= point[:visits] %> visits, <%= point[:leads] %> leads">
          <span class="block w-2/3 rounded-t-sm bg-slate-900/85 transition group-hover:bg-slate-700" style="height:<%= [point[:visits].to_f / max_value * 100, 2].max %>%"></span>
          <span class="block w-1/3 rounded-t-sm bg-amber-300" style="height:<%= [point[:leads].to_f / max_value * 100, point[:leads].positive? ? 4 : 0].max %>%"></span>
        </div>
      <% end %>
    </div>
    <div class="mt-3 flex justify-between text-[10px] font-semibold text-slate-400"><span><%= @range.begin.strftime("%b %-d") %></span><span><%= @range.end.strftime("%b %-d") %></span></div>
  </article>

  <article class="panel p-5 lg:p-6">
    <div class="flex items-center justify-between"><div><p class="eyebrow">Location pulse</p><h2 class="mt-1 text-lg font-bold">Where demand lands</h2></div><%= link_to "Compare", locations_path, class: "text-xs font-bold text-slate-500 hover:text-slate-900" %></div>
    <div class="mt-5 divide-y divide-slate-100">
      <% @summary[:locations].first(5).each do |location| %>
        <div class="flex items-center justify-between py-3.5"><div><p class="text-sm font-bold"><%= location[:name] %></p><p class="mt-0.5 text-xs text-slate-400"><%= location[:visits] %> visits · <%= location[:intent] %> intent</p></div><div class="text-right"><p class="text-sm font-extrabold"><%= location[:leads] %> leads</p><p class="text-xs font-semibold text-emerald-600"><%= money(location[:attributed_value]) %></p></div></div>
      <% end %>
    </div>
  </article>
</section>

<section class="panel mt-5 overflow-hidden">
  <div class="flex items-center justify-between border-b border-slate-100 px-5 py-4 lg:px-6"><div><p class="eyebrow">Latest opportunities</p><h2 class="mt-1 text-lg font-bold">Recent leads</h2></div><%= link_to "Open inbox", leads_path, class: "button-secondary !py-2 !text-xs" %></div>
  <div class="divide-y divide-slate-100">
    <% @recent_leads.each do |lead| %>
      <%= link_to lead_path(lead), class: "grid gap-2 px-5 py-4 transition hover:bg-slate-50 sm:grid-cols-[1.4fr_.8fr_.8fr_auto] sm:items-center lg:px-6" do %>
        <div><p class="text-sm font-bold"><%= lead.contact.name.presence || lead.contact.email || lead.contact.phone %></p><p class="mt-1 line-clamp-1 text-xs text-slate-400"><%= lead.message %></p></div>
        <p class="text-xs font-semibold text-slate-500"><%= lead.location&.name || "Unknown location" %></p>
        <p class="text-xs font-semibold text-slate-500"><%= lead.owner&.name || "Unassigned" %></p>
        <%= status_badge(lead.status) %>
      <% end %>
    <% end %>
    <% if @recent_leads.empty? %><p class="px-6 py-10 text-center text-sm text-slate-400">No leads in this workspace yet.</p><% end %>
  </div>
</section>

