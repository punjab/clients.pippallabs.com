<main class="min-h-screen bg-slate-950 text-white grid place-items-center px-6">
  <section class="w-full max-w-md rounded-3xl border border-white/10 bg-white/5 p-8 shadow-2xl">
    <p class="text-xs font-bold uppercase tracking-[0.24em] text-amber-300">Pippal Labs</p>
    <h1 class="mt-3 text-3xl font-semibold tracking-tight">Welcome back</h1>
    <p class="mt-2 text-sm text-slate-400">Sign in to review demand and follow every opportunity through.</p>

    <% if alert %>
      <div class="mt-5 rounded-xl border border-rose-400/30 bg-rose-400/10 px-4 py-3 text-sm text-rose-200"><%= alert %></div>
    <% end %>

    <%= form_with url: session_path, class: "mt-7 space-y-5" do |form| %>
      <div>
        <%= form.label :email_address, "Email", class: "text-sm font-medium text-slate-300" %>
        <%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "username", class: "mt-2 w-full rounded-xl border border-white/10 bg-slate-900 px-4 py-3 outline-none ring-amber-300 focus:ring-2" %>
      </div>
      <div>
        <%= form.label :password, class: "text-sm font-medium text-slate-300" %>
        <%= form.password_field :password, required: true, autocomplete: "current-password", class: "mt-2 w-full rounded-xl border border-white/10 bg-slate-900 px-4 py-3 outline-none ring-amber-300 focus:ring-2" %>
      </div>
      <%= form.submit "Sign in", class: "w-full cursor-pointer rounded-xl bg-amber-300 px-4 py-3 font-semibold text-slate-950 transition hover:bg-amber-200" %>
    <% end %>
  </section>
</main>

