<% content_for :title, "Leads · Pippal CRM" %>
<div class="flex flex-wrap items-end justify-between gap-4"><div><p class="eyebrow">Lead inbox</p><h1 class="mt-2 text-3xl font-extrabold tracking-tight">Every opportunity, accounted for.</h1><p class="mt-2 text-sm text-slate-500"><%= @leads.size %> leads match this view.</p></div><%= link_to "Overdue follow-ups", leads_path(follow_up: "overdue"), class: "button-secondary" %></div>

<div class="mt-6 flex gap-2 overflow-x-auto pb-1">
  <%= link_to "All", leads_path, class: "rounded-full px-4 py-2 text-xs font-bold #{params[:status].blank? ? 'bg-slate-900 text-white' : 'bg-white text-slate-500 ring-1 ring-slate-200'}" %>
  <% Lead.statuses.keys.each do |status| %><%= link_to "#{status.humanize} · #{@counts[status].to_i}", leads_path(status:), class: "whitespace-nowrap rounded-full px-4 py-2 text-xs font-bold #{params[:status] == status ? 'bg-slate-900 text-white' : 'bg-white text-slate-500 ring-1 ring-slate-200'}" %><% end %>
</div>

<%= form_with url: leads_path, method: :get, class: "panel mt-4 grid gap-3 p-4 md:grid-cols-6" do |form| %>
  <%= form.search_field :q, value: params[:q], placeholder: "Search name or email", class: "field !mt-0 md:col-span-2" %>
  <%= form.select :type, Lead::TYPES.map { |type| [type.humanize, type] }, { include_blank: "All lead types", selected: params[:type] }, class: "field !mt-0" %>
  <%= form.select :location_id, @locations.map { |location| [location.name, location.id] }, { include_blank: "All locations", selected: params[:location_id] }, class: "field !mt-0" %>
  <%= form.select :follow_up, [["Overdue", "overdue"], ["Upcoming", "upcoming"], ["Not scheduled", "unset"]], { include_blank: "Any follow-up", selected: params[:follow_up] }, class: "field !mt-0" %>
  <%= form.submit "Filter", class: "button-primary" %>
<% end %>

<section class="panel mt-4 overflow-hidden">
  <div class="hidden grid-cols-[1.4fr_.7fr_.75fr_.8fr_.55fr] gap-4 border-b border-slate-100 bg-slate-50/70 px-6 py-3 text-[10px] font-extrabold uppercase tracking-[.14em] text-slate-400 md:grid"><span>Contact</span><span>Location</span><span>Owner</span><span>Follow-up</span><span>Status</span></div>
  <div class="divide-y divide-slate-100">
    <% @leads.each do |lead| %>
      <%= link_to lead_path(lead), class: "grid gap-3 px-5 py-4 transition hover:bg-slate-50 md:grid-cols-[1.4fr_.7fr_.75fr_.8fr_.55fr] md:items-center md:px-6" do %>
        <div><p class="text-sm font-bold"><%= lead.contact.name.presence || "Unnamed contact" %></p><p class="mt-1 text-xs text-slate-400"><%= lead.contact.email || lead.contact.phone %> · <%= lead.lead_type.humanize %></p></div>
        <p class="text-xs font-semibold text-slate-500"><%= lead.location&.name || "Unknown" %></p>
        <p class="text-xs font-semibold text-slate-500"><%= lead.owner&.name || "Unassigned" %></p>
        <div><p class="text-xs font-semibold <%= lead.follow_up_at && lead.follow_up_at < Time.current && !lead.terminal? ? 'text-rose-600' : 'text-slate-500' %>"><%= lead.follow_up_at ? l(lead.follow_up_at, format: :short) : "Not scheduled" %></p><p class="mt-1 text-[10px] text-slate-400"><%= time_ago_in_words(lead.created_at) %> ago</p></div>
        <%= status_badge(lead.status) %>
      <% end %>
    <% end %>
    <% if @leads.empty? %><div class="px-6 py-16 text-center"><p class="text-sm font-bold">No leads match these filters.</p><p class="mt-1 text-xs text-slate-400">Try widening the inbox view.</p></div><% end %>
  </div>
</section>
