<% content_for :title, "#{@application.job_applicant.name} · Recruiting" %>
<%= link_to "← Back to recruiting", recruiting_path, class: "text-xs font-bold text-slate-500 hover:text-slate-900" %>
<div class="mt-5 grid gap-5 xl:grid-cols-[1fr_360px]">
  <section class="panel p-6"><p class="eyebrow"><%= @application.job_posting.title %></p><div class="mt-2 flex items-start justify-between gap-4"><div><h1 class="text-3xl font-extrabold tracking-tight"><%= @application.job_applicant.name %></h1><p class="mt-2 text-sm text-slate-500"><%= @application.job_applicant.email %><%= " · #{@application.job_applicant.phone}" if @application.job_applicant.phone %></p></div><%= status_badge(@application.status) %></div><dl class="mt-8 grid gap-5 sm:grid-cols-2"><div><dt class="eyebrow">Availability</dt><dd class="mt-2 text-sm leading-6"><%= @application.availability.presence || "Not provided" %></dd></div><div><dt class="eyebrow">Location</dt><dd class="mt-2 text-sm"><%= @application.location&.name || "All locations" %></dd></div><div class="sm:col-span-2"><dt class="eyebrow">Experience</dt><dd class="mt-2 whitespace-pre-wrap text-sm leading-6"><%= @application.experience.presence || "Not provided" %></dd></div><div class="sm:col-span-2"><dt class="eyebrow">Motivation</dt><dd class="mt-2 whitespace-pre-wrap text-sm leading-6"><%= @application.motivation.presence || "Not provided" %></dd></div></dl></section>
  <aside class="space-y-5"><section class="panel p-6"><p class="eyebrow">Hiring workflow</p><% if next_job_application_status_options(@application).any? %><%= form_with url: recruiting_application_path(@application), method: :patch, class: "mt-4 space-y-3" do |form| %><%= form.select :status, next_job_application_status_options(@application), {}, class: "field" %><%= form.submit "Update stage", class: "button-primary w-full" %><% end %><% else %><p class="mt-3 text-sm text-slate-500">This application is in a terminal stage.</p><% end %></section><section class="panel p-6"><p class="eyebrow">Privacy context</p><dl class="mt-4 space-y-4 text-sm"><div><dt class="text-xs font-bold text-slate-400">Notice version</dt><dd class="mt-1 font-semibold"><%= @application.privacy_notice_version %></dd></div><div><dt class="text-xs font-bold text-slate-400">Future opportunities</dt><dd class="mt-1 font-semibold"><%= @application.future_opportunities_consent? ? "Consented" : "This role only" %></dd></div><div><dt class="text-xs font-bold text-slate-400">Submitted</dt><dd class="mt-1 font-semibold"><%= l @application.occurred_at, format: :long %></dd></div></dl></section></aside>
</div>
<section class="panel mt-5 p-6"><p class="eyebrow">Audit history</p><ol class="mt-4 space-y-3"><% @history.each do |entry| %><li class="rounded-xl bg-slate-50 px-4 py-3 text-sm"><% if entry.change_type == "created" %>Application received<% else %><%= entry.actor&.name || "System" %> moved <%= entry.from_status.humanize %> to <%= entry.to_status.humanize %><% end %><span class="ml-2 text-xs text-slate-400"><%= l entry.occurred_at, format: :short %></span></li><% end %></ol></section>
