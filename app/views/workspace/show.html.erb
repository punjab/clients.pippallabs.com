<% content_for :title, "Workspace setup · Pippal CRM" %>
<div><p class="eyebrow">Agency administration</p><h1 class="mt-2 text-3xl font-extrabold tracking-tight">Configure <%= current_tenant.name %>.</h1><p class="mt-2 text-sm text-slate-500">Tracking keys are shown only when created or rotated.</p></div>
<div class="mt-7 grid gap-5 xl:grid-cols-2 2xl:grid-cols-4">
  <section class="panel p-5"><p class="eyebrow">Optional capabilities</p><div class="mt-4 rounded-xl bg-slate-50 p-4"><div class="flex items-start justify-between gap-4"><div><p class="text-sm font-bold">Recruiting</p><p class="mt-1 text-xs leading-5 text-slate-500">Private applicant intake and hiring workflow for this client.</p></div><span class="rounded-full px-2.5 py-1 text-[10px] font-bold uppercase tracking-wider <%= current_tenant.feature_enabled?(:recruiting) ? 'bg-emerald-100 text-emerald-700' : 'bg-slate-200 text-slate-500' %>"><%= current_tenant.feature_enabled?(:recruiting) ? 'Active' : 'Off' %></span></div><%= form_with url: workspace_feature_path(:recruiting), method: :patch, class: "mt-4" do |form| %><%= form.hidden_field :enabled, value: current_tenant.feature_enabled?(:recruiting) ? "0" : "1" %><%= form.submit current_tenant.feature_enabled?(:recruiting) ? "Disable recruiting" : "Enable recruiting", class: "button-secondary w-full" %><% end %></div></section>
  <section class="panel p-5"><p class="eyebrow">Locations</p><div class="mt-4 space-y-3"><% @locations.each do |location| %><div class="rounded-xl bg-slate-50 p-3"><p class="text-sm font-bold"><%= location.name %></p><p class="mt-1 text-xs text-slate-400"><%= location.key %> · <%= location.alert_email || "No alert recipient" %></p></div><% end %></div><%= form_with model: Location.new, url: workspace_locations_path, class: "mt-5 space-y-3 border-t border-slate-100 pt-5" do |form| %><%= form.text_field :name, required: true, placeholder: "Location name", class: "field" %><%= form.text_field :key, required: true, placeholder: "location-key", class: "field" %><%= form.email_field :alert_email, placeholder: "Lead alert email", class: "field" %><%= form.submit "Add location", class: "button-secondary w-full" %><% end %></section>
  <section class="panel p-5"><p class="eyebrow">Websites & keys</p><div class="mt-4 space-y-3"><% @websites.each do |website| %><div class="rounded-xl bg-slate-50 p-3"><p class="text-sm font-bold"><%= website.name %></p><p class="mt-1 text-xs text-slate-400"><%= website.allowed_domain %> · key ends <%= website.tracking_key_hint %></p><%= button_to "Rotate key", rotate_workspace_website_path(website), class: "mt-2 text-xs font-bold text-rose-600", form: { data: { turbo_confirm: "The current tracking key will stop working. Continue?" } } %></div><% end %></div><%= form_with model: Website.new, url: workspace_websites_path, class: "mt-5 space-y-3 border-t border-slate-100 pt-5" do |form| %><%= form.text_field :name, required: true, placeholder: "Website name", class: "field" %><%= form.text_field :allowed_domain, required: true, placeholder: "example.com", class: "field" %><%= form.collection_select :fallback_location_id, @locations, :id, :name, { include_blank: "No fallback location" }, class: "field" %><%= form.submit "Add website", class: "button-secondary w-full" %><% end %></section>
  <section class="panel p-5"><p class="eyebrow">People & access</p><div class="mt-4 space-y-3"><% @memberships.each do |membership| %><div class="flex items-center gap-3 rounded-xl bg-slate-50 p-3"><span class="grid h-8 w-8 place-items-center rounded-full bg-slate-900 text-[10px] font-bold text-white"><%= initials(membership.user.name) %></span><div><p class="text-sm font-bold"><%= membership.user.name %></p><p class="text-xs text-slate-400"><%= membership.role.humanize %><%= " · #{membership.location.name}" if membership.location %></p></div></div><% end %></div><%= form_with url: workspace_memberships_path, scope: :membership, class: "mt-5 space-y-3 border-t border-slate-100 pt-5" do |form| %><%= form.text_field :name, required: true, placeholder: "Full name", class: "field" %><%= form.email_field :email_address, required: true, placeholder: "Email", class: "field" %><%= form.password_field :password, required: true, minlength: 12, placeholder: "Initial password (12+ chars)", class: "field" %><%= form.select :role, Membership.roles.keys.map { |role| [role.humanize, role] }, {}, class: "field" %><%= form.collection_select :location_id, @locations, :id, :name, { include_blank: "All locations" }, class: "field" %><%= form.submit "Add member", class: "button-secondary w-full" %><% end %></section>
</div>
