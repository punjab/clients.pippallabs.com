<% content_for :title, "Newsletter · Pippal CRM" %>
<div class="flex flex-wrap items-end justify-between gap-4">
  <div><p class="eyebrow">Newsletter</p><h1 class="mt-2 text-3xl font-extrabold tracking-tight">Subscribers, ready to export.</h1><p class="mt-2 text-sm text-slate-500"><%= @signups.size %> signups captured from the website.</p></div>
  <%= link_to "Export CSV", newsletter_path(format: :csv), class: "button-primary" %>
</div>

<section class="panel mt-6 overflow-hidden">
  <div class="hidden grid-cols-[1.6fr_.6fr_.8fr] gap-4 border-b border-slate-100 bg-slate-50/70 px-6 py-3 text-[10px] font-extrabold uppercase tracking-[.14em] text-slate-400 md:grid"><span>Email</span><span>Consent</span><span>Signed up</span></div>
  <div class="divide-y divide-slate-100">
    <% @signups.each do |signup| %>
      <div class="grid gap-2 px-5 py-4 md:grid-cols-[1.6fr_.6fr_.8fr] md:items-center md:px-6">
        <p class="text-sm font-bold"><%= signup.contact.email %></p>
        <span class="inline-flex w-fit rounded-full px-2.5 py-1 text-xs font-bold ring-1 ring-inset <%= signup.contact.email_consent ? "bg-emerald-50 text-emerald-700 ring-emerald-600/10" : "bg-slate-100 text-slate-500 ring-slate-500/10" %>"><%= signup.contact.email_consent ? "Consented" : "No consent" %></span>
        <p class="text-xs font-semibold text-slate-500"><%= l(signup.occurred_at, format: :short) %></p>
      </div>
    <% end %>
    <% if @signups.empty? %><div class="px-6 py-16 text-center"><p class="text-sm font-bold">No newsletter signups yet.</p><p class="mt-1 text-xs text-slate-400">Signups from the website form will land here.</p></div><% end %>
  </div>
</section>
