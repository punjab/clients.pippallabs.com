<article class="panel p-5">
  <div class="flex items-start justify-between gap-3">
    <div>
      <p class="eyebrow"><%= label %></p>
      <p class="mt-2 text-3xl font-extrabold tracking-tight text-slate-950"><%= value %></p>
    </div>
    <span class="grid h-9 w-9 place-items-center rounded-xl <%= tone %>"><%= icon(icon_name, class_name: "h-4 w-4") %></span>
  </div>
  <p class="mt-3 text-xs leading-5 text-slate-400"><%= caption %></p>
</article>

