<% content_for :title, "Reports · Pippal CRM" %>
<div class="flex flex-wrap items-end justify-between gap-4"><div><p class="eyebrow">Monthly summaries</p><h1 class="mt-2 text-3xl font-extrabold tracking-tight">A credible account-level story.</h1><p class="mt-2 text-sm text-slate-500">Versioned snapshots generated from the same records as the dashboard.</p></div><%= form_with url: reports_path, class: "flex gap-2" do |form| %><%= form.month_field :month, value: Date.current.strftime("%Y-%m"), class: "rounded-xl px-3 py-2 text-sm" %><%= form.submit "Generate summary", class: "button-primary" %><% end %></div>
<section class="panel mt-7 overflow-hidden"><div class="hidden grid-cols-[1fr_.8fr_.6fr_auto] border-b border-slate-100 bg-slate-50 px-6 py-3 text-[10px] font-extrabold uppercase tracking-wider text-slate-400 md:grid"><span>Period</span><span>Scope</span><span>Generated</span><span></span></div><div class="divide-y divide-slate-100"><% @reports.each do |report| %><%= link_to report_path(report), class: "grid gap-2 px-6 py-5 hover:bg-slate-50 md:grid-cols-[1fr_.8fr_.6fr_auto] md:items-center" do %><div><p class="text-sm font-bold"><%= report.period_start.strftime("%B %Y") %></p><p class="mt-1 text-xs text-slate-400">Version <%= report.version %></p></div><p class="text-sm font-semibold text-slate-500"><%= report.location&.name || "All locations" %></p><p class="text-xs text-slate-400"><%= l(report.generated_at, format: :short) %></p><%= icon(:arrow, class_name: "h-4 w-4 text-slate-300") %><% end %><% end %><% if @reports.empty? %><div class="px-6 py-16 text-center"><p class="text-sm font-bold">No summaries yet.</p><p class="mt-1 text-xs text-slate-400">Generate the first month above.</p></div><% end %></div></section>

