<% metrics = @report.metrics.with_indifferent_access %><% content_for :title, "#{@report.period_start.strftime('%B %Y')} report · Pippal CRM" %>
<%= link_to "← All reports", reports_path, class: "text-xs font-bold text-slate-400 hover:text-slate-900" %><div class="mt-4 flex flex-wrap items-end justify-between gap-4"><div><p class="eyebrow">Monthly summary · v<%= @report.version %></p><h1 class="mt-2 text-3xl font-extrabold tracking-tight"><%= @report.period_start.strftime("%B %Y") %></h1><p class="mt-2 text-sm text-slate-500"><%= @report.location&.name || "All locations" %> · generated <%= l(@report.generated_at, format: :long) %></p></div><span class="rounded-full bg-emerald-50 px-3 py-1.5 text-xs font-bold text-emerald-700">Reconciled snapshot</span></div>
<section class="mt-7 grid gap-4 sm:grid-cols-2 xl:grid-cols-4"><%= render "shared/metric_card", label: "Visits", value: metrics.dig(:totals, :visits), caption: "Distinct accepted sessions", tone: "bg-blue-50 text-blue-700", icon_name: :insights %><%= render "shared/metric_card", label: "Leads", value: metrics.dig(:totals, :leads), caption: "#{metrics.dig(:totals, :lead_conversion_rate)}% conversion", tone: "bg-violet-50 text-violet-700", icon_name: :leads %><%= render "shared/metric_card", label: "Win rate", value: "#{metrics.dig(:totals, :win_rate)}%", caption: "Won ÷ Won and Lost", tone: "bg-amber-50 text-amber-700", icon_name: :arrow %><%= render "shared/metric_card", label: "Attributed value", value: money(metrics.dig(:totals, :attributed_value)), caption: "Won lead actual value", tone: "bg-emerald-50 text-emerald-700", icon_name: :reports %></section>
<div class="mt-5 grid gap-5 lg:grid-cols-2"><section class="panel p-6"><p class="eyebrow">What happened</p><h2 class="mt-2 text-xl font-bold"><%= metrics.dig(:totals, :order_intent) %> order and <%= metrics.dig(:totals, :call_intent) %> call signals</h2><p class="mt-3 text-sm leading-6 text-slate-500">These are high-intent actions, not transaction revenue. Revenue is shown only when a manager records a won lead’s actual value.</p></section><section class="panel p-6"><p class="eyebrow">Follow-through</p><h2 class="mt-2 text-xl font-bold"><%= metrics.dig(:totals, :won_leads) %> won · <%= metrics.dig(:totals, :lost_leads) %> lost</h2><p class="mt-3 text-sm leading-6 text-slate-500"><%= metrics.dig(:totals, :overdue_follow_ups) %> active leads were overdue when this snapshot was generated.</p></section></div>

